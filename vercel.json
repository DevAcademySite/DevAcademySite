{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/dev.telas/dev.login/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "server.py"
    }
  }
}
